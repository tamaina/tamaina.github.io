---
import '../styles/style.scss';
interface Props { title:string;description?:string;url:string;image?:{og:string};plain?:boolean;noindex?:boolean }
const { title, description='', url, image, plain=false, noindex=false } = Astro.props;
const canonical = new URL(url,'https://a9z.dev').href;
---
<!doctype html>
<html lang="ja"><head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title ? `${title} - aqz/tamaina's homepage` : `a9z.dev - aqz/tamaina's homepage`}</title>
  <meta name="description" content={description} /><meta property="og:title" content={title} /><meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} /><link rel="canonical" href={canonical} />
  <meta name="twitter:card" content={image?'summary_large_image':'summary'} />
  {image && <><meta property="og:image" content={new URL(image.og,'https://a9z.dev').href} /><meta name="twitter:image" content={new URL(image.og,'https://a9z.dev').href} /></>}
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/tamaina/The-Japanese-Web-Fonts@v7.2.0/dist/GenEiUniverSans/GenEiUniverSans.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/yakuhanjp@3.3.0/dist/css/yakuhanjp.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/tamaina/The-Japanese-Web-Fonts@v7.2.0/dist/SourceHanSans/SourceHanSans.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/tamaina/The-Japanese-Web-Fonts@v7.2.0/dist/NasuM/NasuM.css" />
  <script is:inline>
    // Hide only paginated results while resolving a direct query; no-JS stays visible.
    if (new URLSearchParams(location.search).has('page')) document.documentElement.classList.add('paging-pending');
    document.addEventListener('error', function(e) {
      const image=e.target;
      if(image instanceof HTMLImageElement && image.dataset.original && !image.dataset.fallback) {
        image.dataset.fallback='1'; image.src=image.dataset.original;
      }
    },true);
  </script>
</head><body data-bs-theme="light">
  <slot />
  {!plain && <><div class="navbar-spacer"></div><nav class="navbar navbar-expand-lg fixed-bottom navbar-dark bg-dark"><div class="container">
    <a class="navbar-brand fw-bold" href="#">a9z.dev</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon bg-dark"></span></button>
    <div class="collapse navbar-collapse" id="navbarSupportedContent"><ul class="navbar-nav me-auto mb-2 mb-lg-0">
      {[['/','Home'],['/blog','ブログ'],['/products','製品'],['/memo','Memo'],['/privacypolicy','プライバシーポリシー']].map(([href,label])=><li class="nav-item"><a href={href} class="nav-link" aria-current={url===href?'page':undefined}>{label}</a></li>)}
    </ul></div>
  </div></nav></>}
  <script is:inline src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>import '../scripts/browser';</script>
</body></html>
