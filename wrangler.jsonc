{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "a9z-production",
  "compatibility_date": "2026-09-11",
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "a9z.dev/*",
      "zone_name": "a9z.dev"
    }
  ],
  "workers_dev": true
}
